{
    "name": "strix",
    "version": "1.0.0",
    "description": "Lightweight WebGL engine written in TypeScript, for games and web apps",
    "keywords": [
        "WebGL",
        "TypeScript",
        "GLSL",
        "renderer"
    ],
    "homepage": "https://github.com/Owlzy/strix#readme",
    "bugs": {
        "url": "https://github.com/Owlzy/strix/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Owlzy/strix.git"
    },
    "license": "MIT",
    "author": "Owain Bell",
    "type": "module",
    "main": "./dist/strix.umd.cjs",
    "module": "./dist/strix.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/strix.js",
            "require": "./dist/strix.umd.cjs"
        }
    },
    "files": ["dist"],
    "scripts": {
        "dev": "vite serve sample",
        "build": "tsc && vite build",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vite-plugin-dts": "^5.1.0"
    }
}
